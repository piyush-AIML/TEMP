# Educraft environment template — copy to `.env.local` and fill in real values.
# `.env.local` is gitignored; never commit real keys. Next.js loads `.env.local`
# natively; prisma7.config.ts loads it for the Prisma CLI (migrations, seed).

# --- Clerk (dashboard auth) — https://dashboard.clerk.com → your app → API keys
# Env mode: Email + password enabled in User & Authentication.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# --- Postgres (Neon) — https://console.neon.tech → project → connection string
# Use the DIRECT (non-pooled) connection string — works for migrations and the
# app runtime alike at this scale. Do not commit.
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- File storage (professor materials upload, Dashboard Stage 2) — AWS S3
# AWS setup (bucket, IAM policy, CORS) is documented in EDUCRAFT_PRODUCTION.md
# §24.9. Credentials: IAM user (access key + secret) with s3:PutObject /
# s3:GetObject / s3:DeleteObject scoped to <bucket>/materials/*.
S3_REGION=ap-south-1
S3_BUCKET=educraft-materials
S3_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Storage backend for FILE materials. Leave unset/unknown for "uploads disabled"
# (honest UI copy, everything else works); set to `s3` once the vars above are real.
# STORAGE_PROVIDER=s3

# --- Site — canonical production domain (metadata/sitemap/OG). Falls back to https://educraft.com
# NEXT_PUBLIC_SITE_URL=https://educraft.com
